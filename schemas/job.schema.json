{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job",
  "type": "object",
  "required": [
    "id",
    "title",
    "company",
    "description",
    "url",
    "source",
    "extraction_status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "source": {
      "type": "string"
    },
    "ats_family": {
      "enum": [
        "greenhouse",
        "lever",
        "ashby",
        "workday",
        "linkedin",
        "indeed",
        "company_site",
        "unknown"
      ]
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "salary_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "posted_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "extraction_status": {
      "enum": [
        "verified",
        "needs_review",
        "manual_fallback",
        "unavailable"
      ]
    },
    "last_checked_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "preflight": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "liveness_status": {
          "enum": [
            "active",
            "stale_risk",
            "closed",
            "unknown"
          ]
        },
        "scam_risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "scam_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "friction_roi": {
          "enum": [
            "high_roi_low_bot_noise",
            "standard",
            "saturated_easy_apply",
            "high_risk"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
