{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Application",
  "type": "object",
  "required": [
    "job_id",
    "candidate_id",
    "resume_version",
    "status",
    "approved"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "candidate_id": {
      "type": "string"
    },
    "resume_version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "discovered",
        "prepared",
        "waiting_review",
        "approved",
        "submitting",
        "confirmed",
        "unknown",
        "failed",
        "manual_required",
        "test_submitted"
      ]
    },
    "approved": {
      "type": "boolean"
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "submitted_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "confirmation_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    },
    "claim_evidence_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "source_snippet"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "source_snippet": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "slop_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ats_preview_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "copilot_packet": {
      "type": [
        "object",
        "null"
      ]
    },
    "callback_packet": {
      "type": [
        "object",
        "null"
      ]
    },
    "resume_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "answers_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_path": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
